ASTRA_DB_API_ENDPOINT=ISI_ENDPOINT_DATA_API_ANDA
ASTRA_DB_APPLICATION_TOKEN=ISI_TOKEN_ANDA
ASTRA_DB_KEYSPACE=rag
ASTRA_DB_COLLECTION=rag_chatbot
MODEL_ID=Qwen/Qwen2.5-3B-Instruct
# Parameter sampling generasi jawaban (natural namun tetap faktual)
MAX_NEW_TOKENS=768
GEN_DO_SAMPLE=true
GEN_TEMPERATURE=0.45
GEN_TOP_P=0.9
GEN_MIN_P=0.05
GEN_REPETITION_PENALTY=1.08

# Unlimited-OCR & Ingestion RAG (opsional, aktifkan saat upload dokumen)
OCR_BACKEND=vllm
OCR_MODEL_ID=baidu/Unlimited-OCR
OCR_BASE_URL=http://127.0.0.1:8001/v1
# Kosongkan saat dev lokal; isi di server produksi untuk mengunci endpoint dari backend TS/Go
AI_INTERNAL_SECRET=
RAG_ADMIN_SECRET=
# Auto-learn materi KKA baru dari diskusi siswa ke RAG (set false saat eksperimen riset terkontrol)
RAG_AUTO_LEARN_ENABLED=true
RAG_AUTO_LEARN_MAX_SIMILARITY=0.82
