ASTRA_DB_API_ENDPOINT=ISI_ENDPOINT_DATA_API_ANDA
ASTRA_DB_APPLICATION_TOKEN=ISI_TOKEN_ANDA
ASTRA_DB_KEYSPACE=rag
ASTRA_DB_COLLECTION=rag_chatbot
MODEL_ID=Qwen/Qwen2.5-3B-Instruct
# Backend chat: 'local' (HF Transformers, otomatis bf16 di GPU >=16GB) atau 'vllm' (async + streaming)
LLM_BACKEND=local
LLM_LOAD_IN_4BIT=auto
LLM_BASE_URL=http://127.0.0.1:8002/v1
LLM_MODEL_NAME=kka-lora
LLM_API_KEY=EMPTY
# Parameter sampling generasi jawaban (natural namun tetap faktual)
MAX_NEW_TOKENS=768
GEN_DO_SAMPLE=true
GEN_TEMPERATURE=0.45
GEN_TOP_P=0.9
GEN_MIN_P=0.05
GEN_REPETITION_PENALTY=1.08

# Unlimited-OCR & Ingestion RAG (opsional, aktifkan saat upload dokumen)
OCR_BACKEND=vllm
OCR_MODEL_ID=baidu/Unlimited-OCR
OCR_BASE_URL=http://127.0.0.1:8001/v1
# Kosongkan saat dev lokal; isi di server produksi untuk mengunci endpoint dari backend TS/Go
AI_INTERNAL_SECRET=
RAG_ADMIN_SECRET=
# Ambang batas minimal kemiripan vektor Astra DB (<= 0 menonaktifkan filter)
RAG_MIN_SIMILARITY=0.70

# Auto-learn materi KKA baru ke scope global dimatikan secara default agar output
# model tidak masuk sebagai materi resmi sebelum diaudit guru/admin
RAG_AUTO_LEARN_ENABLED=false
RAG_AUTO_LEARN_MAX_SIMILARITY=0.82
